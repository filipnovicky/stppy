#!/bin/bash
#PBS -N s010_matR
#PBS -q qlong
#PBS -J 1-16%10
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=32:mem=32gb
#PBS -o /home/novicky/logs/s010_matR^array_index^.log
#PBS -e /home/novicky/logs/s010_matR^array_index^.err

# Stage 2 for any RUN (qsub -v RUN=anphy61_W jobs/matrix_run.pbs). 16 strided blocks, 10 at once
# (320 CPUs). W costs ~5.9k (61-ch) / ~8k (83-ch) CPU-h -> ~12-16 h per block.
# Submit the next RUN only after this array ends; run jobs/finish_run.pbs by hand.
set -eu
source /home/novicky/miniconda3/etc/profile.d/conda.sh
conda activate base
cd /home/novicky/stppy010_anphy61_n2
export NBLOCKS=16 NCPUS=32
python -u matrix_block.py
